# ==============================================================================
# FRP Client Configuration for Minecraft Dedicated Server Architecture
# ==============================================================================

serverAddr = "1.2.3.4"      # Replace with your FRP Server (frps) public IP
serverPort = 7000           # Replace with your FRP Server bind port

# Authentication Token
auth.token = "YOUR_FRP_AUTH_TOKEN"

# 1. Minecraft Game Service (TCP)
[[proxies]]
name = "minecraft-java"
type = "tcp"
localIP = "127.0.0.1"
localPort = 25565
remotePort = 25565          # Mapped public game port

# 2. Simple Voice Chat (UDP)
[[proxies]]
name = "minecraft-voice"
type = "udp"
localIP = "127.0.0.1"
localPort = 24454
remotePort = 24454          # Mapped public voice port

# 3. Secure Management SSH (TCP)
[[proxies]]
name = "mgmt-ssh"
type = "tcp"
localIP = "127.0.0.1"
localPort = 22
remotePort = 60022          # Mapped remote management port
